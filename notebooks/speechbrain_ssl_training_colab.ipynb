OLDER_DRIVE: This is where all experiment outputs (checkpoints, logs, modified hparams) will go.\\nOUTPUT_FOLDER_DRIVE = os.path.join(BASE_DRIVE_PATH, \\\"colab_experiments\\\", EXPERIMENT_NAME)\\n\\nHPARAMS_FILE_EXP_PATH = os.path.join(OUTPUT_FOLDER_DRIVE, \\\"hparams_ssl_colab_exp.yaml\\\")\\nTRAIN_MANIFEST_FULL_PATH_DRIVE = os.path.join(DATA_FOLDER_DRIVE, TRAIN_MANIFEST_REL_PATH)\\n\\n# KMEANS_TARGET_DIR_FULL_PATH_DRIVE: Full path to where k-means targets will be stored for this experiment.\\n# This path will override 'target_label_dir' in hparams.\\nKMEANS_TARGET_DIR_FULL_PATH_DRIVE = os.path.join(OUTPUT_FOLDER_DRIVE, KMEANS_TARGET_DIR_REL_PATH)\\n\\n# --- Setup Directories and Hparams ---\\nprint(f\\\"COLAB_PROJECT_ROOT: {COLAB_PROJECT_ROOT}\\\")\\nprint(f\\\"HPARAMS_FILE_SOURCE_PATH (in Colab's runtime): {HPARAMS_FILE_SOURCE_PATH}\\\")\\nprint(f\\\"OUTPUT_FOLDER_DRIVE (on Google Drive): {OUTPUT_FOLDER_DRIVE}\\\")\\nprint(f\\\"HPARAMS_FILE_EXP_PATH (modified hparams on Drive): {HPARAMS_FILE_EXP_PATH}\\\")\\nprint(f\\\"DATA_FOLDER_DRIVE (source data on Drive): {DATA_FOLDER_DRIVE}\\\")\\nprint(f\\\"TRAIN_MANIFEST_FULL_PATH_DRIVE (on Google Drive): {TRAIN_MANIFEST_FULL_PATH_DRIVE}\\\")\\nprint(f\\\"KMEANS_TARGET_DIR_FULL_PATH_DRIVE (on Google Drive): {KMEANS_TARGET_DIR_FULL_PATH_DRIVE}\\\")\\n\\nos.makedirs(OUTPUT_FOLDER_DRIVE, exist_ok=True)\\n# It's assumed DATA_FOLDER_DRIVE already exists with data.\\n# os.makedirs(DATA_FOLDER_DRIVE, exist_ok=True) # Usually not needed if data is pre-placed\\nos.makedirs(KMEANS_TARGET_DIR_FULL_PATH_DRIVE, exist_ok=True)\\nprint(f\\\"Ensured Drive output directories exist for experiment: {EXPERIMENT_NAME}\\\")\\n\\nif not os.path.exists(HPARAMS_FILE_SOURCE_PATH):\\n    raise FileNotFoundError(f\\\"Original hparams file not found at {HPARAMS_FILE_SOURCE_PATH}. Please check HPARAMS_FILE_REL_PATH and ensure COLAB_PROJECT_ROOT is correct (root of cloned repo).\\\")\\n\\nwith open(HPARAMS_FILE_SOURCE_PATH, 'r') as f:\\n    hparams_yaml_content = yaml.safe_load(f)\\n\\n# Override paths in the YAML content\\nhparams_yaml_content['data_folder'] = DATA_FOLDER_DRIVE\\nhparams_yaml_content['train_sb_manifest_file'] = TRAIN_MANIFEST_FULL_PATH_DRIVE\\nhparams_yaml_content['output_folder'] = OUTPUT_FOLDER_DRIVE\\nhparams_yaml_content['target_label_dir'] = KMEANS_TARGET_DIR_FULL_PATH_DRIVE\\n\\nif 'kmeans_model_path' in hparams_yaml_content:\\n    kmeans_model_filename = os.path.basename(str(hparams_yaml_content['kmeans_model_path']))\\n    hparams_yaml_content['kmeans_model_path'] = os.path.join(OUTPUT_FOLDER_DRIVE, kmeans_model_filename)\\n    print(f\\\"Overridden kmeans_model_path to: {hparams_yaml_content['kmeans_model_path']}\\\")\\n\\nwith open(HPARAMS_FILE_EXP_PATH, 'w') as f:\\n    yaml.dump(hparams_yaml_content, f)\\nprint(f\\\"Copied and modified hparams saved to: {HPARAMS_FILE_EXP_PATH}\\\")\\n\\nif 'tpu_device' in locals() and tpu_device:\\n    device_to_use = tpu_device \\n    print(\\\"Using TPU device.\\\")\\nelif torch.cuda.is_available():\\n    device_to_use = \\\"cuda\\\"\\n    print(\\\"Using CUDA device.\\\")\\nelse:\\n    device_to_use = \\\"cpu\\\"\\n    print(\\\"Using CPU device.\\\")\\n\\ncolab_script_args = {\\n    \\\"hparams_file\\\": HPARAMS_FILE_EXP_PATH, \\n    \\\"output_folder\\\": OUTPUT_FOLDER_DRIVE,\\n    \\\"data_folder\\\": DATA_FOLDER_DRIVE,\\n    \\\"device\\\": device_to_use\\n}\\nprint(f\\\"Arguments for the training script logic: {colab_script_args}\\\")"

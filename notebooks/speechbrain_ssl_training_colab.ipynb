  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\\n",
    "import torch\\n",
    "import torch.nn.functional as F\\n",
    "import speechbrain as sb\\n",
    "from speechbrain.dataio.dataset import DynamicItemDataset\\n",
    "from speechbrain.dataio.dataio import read_audio\\n",
    "from speechbrain.lobes.models.huggingface_wav2vec import HuggingFaceWav2Vec2\\n",
    "import os\\n",
    "import logging\\n",
    "import argparse\\n",
    "import yaml\\n",
    "import numpy as np\\n",
    "\\n",
    "logger = logging.getLogger(__name__)\\n",
    "if not logger.hasHandlers():\\n",
    "    logging.basicConfig(\\n",
    "        level=logging.INFO,\\n",
    "        format=\\"%(asctime)s [%(levelname)s] %(name)s - %(module)s.%(funcName)s - %(message)s\\",\\n",
    "        datefmt=\\"%Y-%m-%d %H:%M:%S\\",\\n",
    "    )\\n",
    "else:\\n",
    "    logger.setLevel(logging.INFO)\\n",
    "\\n",
    "class SSLBrain(sb.Brain):\\n",
    "    def __init__(self, modules=None, opt_class=None, hparams=None, run_opts=None, checkpointer=None):\\n",
    "        super().__init__(modules, opt_class, hparams, run_opts, checkpointer)\\n",
    "        if hasattr(self.modules, 'wav2vec2_model') and hasattr(self.modules, 'ssl_head'):\\n",
    "            try:\\n",
    "                if hasattr(self.modules.wav2vec2_model, 'model') and \\\\\\n",
    "                   hasattr(self.modules.wav2vec2_model.model, 'config') and \\\\\\n",
    "                   hasattr(self.modules.wav2vec2_model.model.config, 'hidden_size'):\\n",
    "                    encoder_out_dim = self.modules.wav2vec2_model.model.config.hidden_size\\n",
    "                    current_ssl_head = self.modules.ssl_head\\n",
    "                    if isinstance(current_ssl_head, sb.nnet.linear.Linear):\\n",
    "                        if hasattr(current_ssl_head, 'layers') and len(current_ssl_head.layers) > 0 and \\\\\\n",
    "                           isinstance(current_ssl_head.layers[0], torch.nn.Linear):\\n",
    "                            actual_linear_layer = current_ssl_head.layers[0]\\n",
    "                            if actual_linear_layer.in_features != encoder_out_dim :\\n",
    "                                logger.info(f\\"Dynamically re-initializing ssl_head. Original: {actual_linear_layer.in_features}, New: {encoder_out_dim}\\")\\n",
    "                                self.modules.ssl_head = sb.nnet.linear.Linear(\\n",
    "                                    input_size=encoder_out_dim, \\n",
    "                                    n_neurons=self.hparams.num_ssl_clusters,\\n",
    "                                    bias=True\\n",
    "                                ).to(self.device)\\n",
    "                            else:\\n",
    "                                logger.info(f\\"SSL_Head input ({actual_linear_layer.in_features}) matches Wav2Vec2 output ({encoder_out_dim}).\\")\\n",
    "                        else: logger.warning(\\"Could not verify/set ssl_head input size dynamically.\\")\\n",
    "                else: logger.warning(\\"Could not dynamically determine wav2vec2_model output size for ssl_head.\\")\\n",
    "            except Exception as e: logger.warning(f\\"Error dynamically setting/checking ssl_head input size: {e}\\")\\n",
    "        \\n",
    "        if hasattr(self.modules, 'wav2vec2_model') and hasattr(self.modules.wav2vec2_model, 'model'):\\n",
    "             feat_dim = self.modules.wav2vec2_model.model.config.hidden_size\\n",
    "             self.mask_embedding = torch.nn.Parameter(torch.FloatTensor(feat_dim).uniform_())\\n",
    "             logger.info(f\\"Initialized learnable mask embedding: {self.mask_embedding.shape}\\")\\n",
    "        else:\\n",
    "            logger.error(\\"wav2vec2_model not available for mask_embedding.\\")\\n",
    "            self.mask_embedding = torch.nn.Parameter(torch.FloatTensor(1).uniform_())\\n",
    "\\n",
    "    def mask_acoustic_features(self, features, wav_lens):\\n",
    "        batch_size, seq_len, _ = features.shape\\n",
    "        boolean_mask = torch.zeros((batch_size, seq_len), dtype=torch.bool, device=features.device)\\n",
    "        masked_features = features.clone()\\n",
    "        for i in range(batch_size):\\n",
    "            current_num_frames = int(torch.round(wav_lens[i] * seq_len))\\n",
    "            if current_num_frames == 0: continue\\n",
    "            num_frames_to_mask = int(current_num_frames * self.hparams.mask_prob)\\n",
    "            min_frames_for_min_spans = self.hparams.mask_min_spans * self.hparams.mask_length\\n",
    "            if num_frames_to_mask < min_frames_for_min_spans and current_num_frames >= min_frames_for_min_spans :\\n",
    "                num_frames_to_mask = min_frames_for_min_spans\\n",
    "            num_frames_to_mask = min(num_frames_to_mask, current_num_frames)\\n",
    "            masked_indices_count = 0; attempts = 0\\n",
    "            while masked_indices_count < num_frames_to_mask and attempts < current_num_frames * 5:\\n",
    "                span_start = torch.randint(0, current_num_frames - self.hparams.mask_length + 1, (1,)).item()\\n",
    "                if masked_indices_count + self.hparams.mask_length > num_frames_to_mask * 1.5 and masked_indices_count > 0:\\n",
    "                    attempts += 1; continue \\n",
    "                for j in range(self.hparams.mask_length):\\n",
    "                    idx_to_mask = span_start + j\\n",
    "                    if idx_to_mask < current_num_frames:\\n",
    "                        if not boolean_mask[i, idx_to_mask]:\\n",
    "                            boolean_mask[i, idx_to_mask] = True\\n",
    "                            masked_features[i, idx_to_mask, :] = self.mask_embedding\\n",
    "                            masked_indices_count += 1\\n",
    "                    if masked_indices_count >= num_frames_to_mask: break\\n",
    "                if masked_indices_count >= num_frames_to_mask: break\\n",
    "                attempts += 1\\n",
    "            if num_frames_to_mask > 0 and masked_indices_count == 0: logger.debug(f\\"Item {i}: Could not mask. Req: {num_frames_to_mask}, Actual: {current_num_frames}\\")\\n",
    "            elif masked_indices_count < num_frames_to_mask: logger.debug(f\\"Item {i}: Masked {masked_indices_count}/{num_frames_to_mask}. Actual: {current_num_frames}\\")\\n",
    "        return masked_features, boolean_mask\\n",
    "\\n",
    "    def compute_forward(self, batch, stage):\\n",
    "        batch = batch.to(self.device); wavs, wav_lens = batch.sig\\n",
    "        kmeans_targets_padded, kmeans_target_lens_abs = batch.kmeans_targets \\n",
    "        encoder_output_features = self.modules.wav2vec2_model(wavs, wav_lens)\\n",
    "        masked_input_for_head, time_mask_indices = self.mask_acoustic_features(encoder_output_features, wav_lens)\\n",
    "        predictions_logits = self.modules.ssl_head(masked_input_for_head)\\n",
    "        return predictions_logits, time_mask_indices, kmeans_targets_padded, kmeans_target_lens_abs\\n",
    "\\n",
    "    def compute_objectives(self, forward_outputs, batch, stage):\\n",
    "        predictions_logits, time_mask_indices, kmeans_targets_padded, kmeans_target_lens_abs = forward_outputs\\n",
    "        kmeans_targets_padded = kmeans_targets_padded.to(predictions_logits.device)\\n",
    "        pred_seq_len = predictions_logits.size(1); target_seq_len = kmeans_targets_padded.size(1)\\n",
    "        if pred_seq_len != target_seq_len:\\n",
    "            min_len = min(pred_seq_len, target_seq_len)\\n",
    "            predictions_logits = predictions_logits[:, :min_len, :]; kmeans_targets_padded = kmeans_targets_padded[:, :min_len]; time_mask_indices = time_mask_indices[:, :min_len]\\n",
    "        masked_logits = predictions_logits[time_mask_indices] \\n",
    "        masked_targets = kmeans_targets_padded[time_mask_indices]\\n",
    "        if masked_logits.nelement() == 0 or masked_targets.nelement() == 0:\\n",
    "            logger.warning(\\"No masked frames for loss. Returning zero loss.\\"); return torch.tensor(0.0, device=self.device, requires_grad=True)\\n",
    "        loss = F.cross_entropy(masked_logits.reshape(-1, self.hparams.num_ssl_clusters), masked_targets.reshape(-1))\\n",
    "        if stage != sb.Stage.TRAIN:\\n",
    "            with torch.no_grad():\\n",
    "                predicted_ids = torch.argmax(masked_logits, dim=-1)\\n",
    "                correct_predictions = (predicted_ids == masked_targets).sum().item(); total_masked = masked_targets.numel()\\n",
    "                self.last_batch_accuracy = correct_predictions / total_masked if total_masked > 0 else 0.0\\n",
    "        return loss\\n",
    "\\n",
    "    def on_stage_start(self, stage, epoch):\\n",
    "        if stage != sb.Stage.TRAIN: self.accuracies_this_epoch = []\\n",
    "\\n",
    "    def on_stage_end(self, stage, stage_loss, epoch):\\n",
    "        stage_name = stage.name.capitalize()\\n",
    "        if stage == sb.Stage.TRAIN: self.train_loss = stage_loss\\n",
    "        logger.info(f\\"Epoch {epoch}: {stage_name} Loss = {stage_loss:.4f}\\")\\n",
    "        if stage != sb.Stage.TRAIN:\\n",
    "            if hasattr(self, 'accuracies_this_epoch') and self.accuracies_this_epoch:\\n",
    "                avg_accuracy = sum(self.accuracies_this_epoch) / len(self.accuracies_this_epoch)\\n",
    "                logger.info(f\\"Epoch {epoch}: {stage_name} Average Accuracy = {avg_accuracy:.3f}\\")\\n",
    "            elif hasattr(self, 'last_batch_accuracy'): logger.info(f\\"Epoch {epoch}: {stage_name} Last Batch Accuracy = {self.last_batch_accuracy:.3f}\\")\\n",
    "\\n",
    "def dataio_prepare(hparams):\\n",
    "    logger.info(\\"Preparing datasets for HuBERT-style SSL training...\\")\\n",
    "    target_label_dir = hparams[\\"target_label_dir\\"]\\n",
    "    logger.info(f\\"K-means target labels expected from: {target_label_dir}\\")\\n",
    "    if not os.path.isdir(target_label_dir): logger.warning(f\\"K-means target label directory DOES NOT exist: {target_label_dir}. This WILL error if labels are needed now.\\")\\n",
    "\\n",
    "    @sb.utils.data_pipeline.takes(\\"wav\\")\\n",
    "    @sb.utils.data_pipeline.provides(\\"sig\\")\\n",
    "    def audio_pipeline(wav_path):\\n",
    "        try: return read_audio(wav_path)\\n",
    "        except Exception as e: logger.error(f\\"Error reading audio {wav_path}: {e}\\", exc_info=True); raise\\n",
    "\\n",
    "    @sb.utils.data_pipeline.takes(\\"id\\")\\n",
    "    @sb.utils.data_pipeline.provides(\\"kmeans_targets\\")\\n",
    "    def label_pipeline(utt_id):\\n",
    "        label_filename = f\\"{utt_id}_kmeans_labels.npy\\"\\n",
    "        label_path = os.path.join(target_label_dir, label_filename)\\n",
    "        try:\\n",
    "            targets = np.load(label_path); return torch.from_numpy(targets).long()\\n",
    "        except FileNotFoundError: logger.error(f\\"K-means target file not found: {label_path}.\\"); raise\\n",
    "        except Exception as e: logger.error(f\\"Error loading K-means target {label_path}: {e}\\", exc_info=True); raise\\n",
    "\\n",
    "    datasets_map = {}\\n",
    "    data_info = {\\"train\\": hparams[\\"train_sb_manifest_file\\"]}\\n",
    "\\n",
    "    for dataset_name, manifest_file_path in data_info.items():\\n",
    "        if not manifest_file_path or not os.path.exists(manifest_file_path):\\n",
    "            logger.warning(f\\"Manifest for '{dataset_name}' not found at {manifest_file_path} or path empty. Skipping.\\")\\n",

    # A truly robust reconstruction would map all original cells.
    already_added = any("## Notes" in "".join(c.get("source",[])) for c in new_cells if c.get("cell_type") == "markdown")
    if not already_added:
         new_cells.append(cells[notes_md_idx])


# Reconstruct the notebook with the new cell order and modifications
notebook_data["cells"] = new_cells

# Ensure nbformat and nbformat_minor are present (usually 4 and 5)
if "nbformat" not in notebook_data: notebook_data["nbformat"] = 4
if "nbformat_minor" not in notebook_data: notebook_data["nbformat_minor"] = 5


# Convert the modified notebook data back to a JSON string
# Using indent=1 for a format closer to actual .ipynb files.
updated_notebook_content = json.dumps(notebook_data, indent=1)
print(updated_notebook_content)

import json

def create_cell(cell_type, source_string):
    # Split the source string into lines
    source_lines = source_string.splitlines()
    
    processed_source_lines = []
    if not source_lines: 
        processed_source_lines.append("")
    else:
        for i, line in enumerate(source_lines):
            # Add newline to all lines except the very last line if it's empty
            # or if the original cell content didn't end with a newline.
            # Most ipynb source lines end with \n in the JSON.
            if i == len(source_lines) - 1:
                processed_source_lines.append(line) # Last line as is
            else:
                processed_source_lines.append(line + "\\n")
        
        # Post-processing based on common ipynb formatting:
        # If the original last line from splitlines() was empty, it means the cell ended with a newline.
        # In this case, the last item in processed_source_lines is an empty string.
        # If the original last line had content, it's now in processed_source_lines[-1] without a trailing \n.
        # This logic attempts to match the typical ipynb source array format more closely.
        # If a line in the list (that is not the last line) is empty, it should be "\n"
        # If the last line in the list is empty, it should be ""
        # If a line has content, it should be "content" (if last) or "content\n" (if not last)

    final_source_list = []
    if not source_lines: # Completely empty source
        final_source_list.append("")
    else:
        for idx, line_text in enumerate(source_lines):
            if idx == len(source_lines) - 1: # Last line
                final_source_list.append(line_text)
            else:
                final_source_list.append(line_text + "\\n")
                
    cell = {
        "cell_type": cell_type,
        "metadata": {}, 
        "source": final_source_list
    }
    if cell_type == "code":
        cell["execution_count"] = None
        cell["outputs"] = []
    return cell


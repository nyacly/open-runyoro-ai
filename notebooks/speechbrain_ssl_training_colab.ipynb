# Helper to create a new code cell dictionary
def create_code_cell_dict(source_code_list):
    # Ensure each line ends with \n, except possibly the last line if it's empty
    processed_source = []
    for i, line in enumerate(source_code_list):
        if i == len(source_code_list) - 1 and not line.strip():
            processed_source.append(line) # Keep last empty line as is
        elif line.endswith('\\n'):
            processed_source.append(line)
        else:
            processed_source.append(line + '\\n')
    # Remove trailing newline from the very last line of source if it's just a newline character
    if processed_source and processed_source[-1] == '\\n' and len(processed_source) > 1:
         processed_source[-1] = "" # if last line is just \n, make it empty string
    elif processed_source and processed_source[-1].endswith('\\n') and not processed_source[-1].strip(): # if ends with \n but is otherwise empty
        pass # keep it as is, e.g. "\n" for a blank line.
    elif processed_source and processed_source[-1].endswith('\\n'): # if last line has content and ends with \n
         processed_source[-1] = processed_source[-1][:-2] # remove the trailing \n

    return {
        "cell_type": "code",
        "execution_count": None,
        "metadata": {},
        "outputs": [],
        "source": processed_source
    }

